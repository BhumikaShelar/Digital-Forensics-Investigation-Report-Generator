# ==========================================
# 🛡️ Git Ignore Configuration
# Prevent secrets, credentials, databases, and artifacts from being committed
# ==========================================

# Secrets & Environment Files
.env
*.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials/
.aws/
service-account*.json
*_rsa
*_dsa
*_ecdsa
*_ed25519

# SQLite Databases & Forensic Data/Evidence Dumps
*.db
*.sqlite
*.sqlite3
forensics.db
sample_evidence_disk.dd
*.dd
*.e01
*.E01
*.raw
*.vmem
*.pcap

# Generated Export Files & PDF Reports
exports/
reports/
*.pdf

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit Local Config & Cache
.streamlit/

# IDE & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# AI Assistant & IDE Agents Metadata
.claude/
.agents/
.antigravity/